license=('GPL-3.0-only')
source_x86_64=(
  "$_pkgname-$pkgver-x86_64::$url/releases/download/v$pkgver/${_pkgname}_linux_amd64"
)
source_aarch64=(
  "$_pkgname-$pkgver-aarch64::$url/releases/download/v$pkgver/${_pkgname}_linux_arm64"
)
arch=('x86_64' 'aarch64')
sha512sums_x86_64=('728a7b1031b7ce93d7811bc0da451ad6a638c0e80d8cf5ece534eab490daf4afff33640d5a50cec549e7a751ba915937d6b5c94ce5bf5c942485482b9e4c900e')
sha512sums_aarch64=('67d661c399e0e81cee99ea158711878fed5fd1b20bf194e8885e6c48637599be3a7b61a8a045db2c20150d3478d71a5e62d7f317635bb6870e563910555f6d03')
provides=("$_pkgname")
conflicts=("$_pkgname" "${_pkgname}-git")

package() {
  install -D -m 0755 "$srcdir/$_pkgname-$pkgver-$CARCH" "$pkgdir/usr/bin/$_pkgname"
}

