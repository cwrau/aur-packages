_pkgname=muster
pkgname=$_pkgname-bin
pkgver=5.64.4 # renovate: datasource=github-releases depName=giantswarm/muster
pkgrel=1
pkgdesc="MCP tool management and workflow proxy"
url="https://github.com/giantswarm/$_pkgname"
license=('Apache-2.0')
arch=('x86_64' 'aarch64')
provides=("$_pkgname")
conflicts=("$_pkgname" "${_pkgname}-git")
source_x86_64=(
  "$_pkgname-$pkgver-x86_64::$url/releases/download/v$pkgver/${_pkgname}-linux-amd64"
)
source_aarch64=(
  "$_pkgname-$pkgver-aarch64::$url/releases/download/v$pkgver/${_pkgname}-linux-arm64"
)
sha512sums_x86_64=('30507af1eb2ccb08128b34ddde8004708366f79bcc1582fa757bc396781e7ff8cbd12e5cab73a6adf20bb2c64b96aaf4b2d370e0a391d462536e23e63714a889')
sha512sums_aarch64=('e071cdaa041a72dafff222b85c012eacc991362217d5c6dab57030421334cddb7fb9f13435dba29a06e06fcb00bb4e647c4c6ab12e97a7be376abbadc2ea1494')

package() {
  install -D -m 0755 "$srcdir/$_pkgname-$pkgver-$CARCH" "$pkgdir/usr/bin/$_pkgname"
}

