_pkgname=muster
pkgname=$_pkgname-bin
pkgver=0.24.0 # renovate: datasource=github-releases depName=giantswarm/muster
pkgrel=1
pkgdesc="MCP tool management and workflow proxy"
url="https://github.com/giantswarm/$_pkgname"
license=('Apache-2.0')
arch=('x86_64' 'aarch64')
provides=("$_pkgname")
conflicts=("$_pkgname" "${_pkgname}-git")
source_x86_64=(
  "$_pkgname-$pkgver-x86_64::$url/releases/download/v$pkgver/${_pkgname}-linux-amd64"
)
source_aarch64=(
  "$_pkgname-$pkgver-aarch64::$url/releases/download/v$pkgver/${_pkgname}-linux-arm64"
)
sha512sums_x86_64=('453129f18ec28c1e8ad01e0953992eff89e475aaaa8e89a8720b81159f20c0272af06d681653cc14831998a07ba615dfc99e437ca8908e3acc836c7b73cb2a19')
sha512sums_aarch64=('48e5b0de9c388094a3589b39f3df6aa07ed9bd0aca57fd8243ba62f51b96c66d6a720849d8ab90f167ea65aea41f5b1caf82aa0a73b7d094e876cdb704972060')

package() {
  install -D -m 0755 "$srcdir/$_pkgname-$pkgver-$CARCH" "$pkgdir/usr/bin/$_pkgname"
}

