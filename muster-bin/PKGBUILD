_pkgname=muster
pkgname=$_pkgname-bin
pkgver=5.39.6 # renovate: datasource=github-releases depName=giantswarm/muster
pkgrel=1
pkgdesc="MCP tool management and workflow proxy"
url="https://github.com/giantswarm/$_pkgname"
license=('Apache-2.0')
arch=('x86_64' 'aarch64')
provides=("$_pkgname")
conflicts=("$_pkgname" "${_pkgname}-git")
source_x86_64=(
  "$_pkgname-$pkgver-x86_64::$url/releases/download/v$pkgver/${_pkgname}-linux-amd64"
)
source_aarch64=(
  "$_pkgname-$pkgver-aarch64::$url/releases/download/v$pkgver/${_pkgname}-linux-arm64"
)
sha512sums_x86_64=('876d17493acb95130413d6b1a50d286fdb925b8b49724dc1422d2a738844d58c39361a3e0e2ab3b5fdf57e9f5742e1ec4dcbfc7e48b8629c1ee13bd7e1ea3338')
sha512sums_aarch64=('70b47b8ab4fe18edaa79a8d1b2c693916e8599e805f9e564fca4a5a949c2f57b241114be1f9fa4703f817dc44fd107c20bab51de810fae2e44ebebb267536cf6')

package() {
  install -D -m 0755 "$srcdir/$_pkgname-$pkgver-$CARCH" "$pkgdir/usr/bin/$_pkgname"
}

